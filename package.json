{
	"name": "fastfile",
	"version": "0.3.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:workers": "sed -i -e 's#^//[[:space:]]*\"main\"#\"main\"#' -e 's#^[[:space:]]*\"pages_build_output_dir\".*#// & #' wrangler.jsonc && wrangler deploy",
		"deploy:pages": "sed -i -e 's#^//[[:space:]]*\"pages_build_output_dir\"#\"pages_build_output_dir\"#' -e 's#^[[:space:]]*\"main\".*#// & #' wrangler.jsonc && wrangler pages deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"vitest": "~3.2.0",
		"wrangler": "^4.71.0"
	}
}
